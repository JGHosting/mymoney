# Kopieren nach .env (cp .env.example .env) und ausfüllen. Die .env gehört NIE ins Repository.

# --- Bank ---
# FinTS-Server der Bank. VR-Banken nutzen in der Regel den zentralen Atruvia-Server;
# die verbindliche Adresse steht in der FinTS-Bankenliste (kommt per E-Mail über den Verteiler) bzw. beim Support.
FINTS_URL=https://fints1.atruvia.de/cgi-bin/hbciservlet
# Bankleitzahl deiner VR Bank
FINTS_BLZ=
# VR-NetKey oder Alias (Anmeldename im Online-Banking)
FINTS_USER=
# Registrierungsnummer aus der FinTS-Produktregistrierung
FINTS_PRODUCT_ID=
FINTS_PRODUCT_VERSION=1.0
# Optional: TAN-Verfahren fest vorgeben (sonst automatisch: SecureGo plus bzw. erstes entkoppeltes Verfahren)
# FINTS_TAN_METHOD=
# FINTS_TAN_MEDIA=

# --- Brücke ---
# Zugangsschlüssel für die App, mindestens 32 Zeichen:  openssl rand -hex 32
BRIDGE_TOKEN=
# Adresse der App (CORS), ohne Pfad
ALLOWED_ORIGIN=https://jghosting.github.io
PORT=8787

# --- Nur Variante A (VPS mit Caddy) ---
# Domain, unter der die Brücke erreichbar ist, z. B. finanzen.deinedomain.de oder deinname.duckdns.org
DOMAIN=

# Bewusst NICHT vorgesehen: FINTS_PIN. Die PIN wird bei jedem Abruf in der App abgefragt.
