# Diese Werte gehören NUR in die .env der FinTS-Brücke (server/, Phase 5) – nie ins Repository, nie in die App.
# Die App selbst braucht keine Umgebungsvariablen.

# FinTS-Server der Bank. VR-Banken nutzen in der Regel den zentralen Atruvia-Server –
# die genaue Adresse steht in der FinTS-Bankenliste bzw. beim Online-Banking-Support der Bank.
FINTS_URL=https://fints1.atruvia.de/cgi-bin/hbciservlet
# Bankleitzahl der VR Bank
FINTS_BLZ=
# VR-NetKey oder Alias (Anmeldename im Online-Banking)
FINTS_USER=
# Produkt-ID aus der FinTS-Produktregistrierung (Deutsche Kreditwirtschaft)
FINTS_PRODUCT_ID=

# Zugangsschlüssel, den die App bei jedem Aufruf mitschickt (lange Zufallszeichenkette, z. B. `openssl rand -hex 32`)
BRIDGE_TOKEN=
# Adresse, unter der die App läuft (CORS), z. B. https://jghosting.github.io
ALLOWED_ORIGIN=
PORT=8787

# Bewusst NICHT vorgesehen: FINTS_PIN. Die PIN wird bei jedem Sync in der App abgefragt.
